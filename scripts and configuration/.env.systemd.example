# Environment for capture / sensor services on the Raspberry Pi.
# Copy to the project root as .env.systemd and adjust.
# See plan.pdf: selective (energy) vs continuous (dataset) applications.

# --- Application mode ---
# selective  = oneshot capture after wake, then halt (insect-capture.service)
# continuous = Pi stays on in the daily window; no automatic poweroff
CAPTURE_MODE=selective

# --- Capture (Camera Module 3 / second camera when configured) ---
# Interval between photos in continuous mode (seconds). Plan example: 300 (5 min).
CAPTURE_INTERVAL=30

# Optional daily window for continuous mode (local time, HH:MM)
# DAILY_WINDOW_START=06:00
# DAILY_WINDOW_END=20:00

# --- Sensors on the Pi (methane, soil, water, GPS). BME280 is on the ESP only. ---
# Burst interval in continuous mode (seconds). Plan example: 60 (1 min).
SENSOR_INTERVAL=60

# --- Python environment (choose one) ---
# PYENV_VERSION=3.11.9
# PYENV_ROOT=/home/rpi5-03/.pyenv
# Or a plain venv:
# PYENV_ROOT=/home/rpi5-03/venv

# PROJECT_DIR=/home/rpi5-03/tesi
