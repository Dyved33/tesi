# Environment variables for systemd service (insect-capture.service)
# Copy this to .env.systemd and adjust values for your Pi

# Capture interval for continuous mode (seconds)
CAPTURE_INTERVAL=30

# Python environment - choose one:
# PYENV_VERSION=3.11.9          # if using pyenv
# PYENV_ROOT=/home/rpi5-03/.pyenv  # if using pyenv

# Or if using a regular virtualenv:
# PYENV_ROOT=/home/rpi5-03/venv   # points to venv folder (with bin/activate)

# Project directory (usually auto-detected from capture_rpi.sh location)
# PROJECT_DIR=/home/rpi5-03/tesi