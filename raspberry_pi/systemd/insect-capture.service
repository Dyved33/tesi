# Unità systemd per l'app selettiva: al boot (dopo il wake dall'ESP) fa
# una foto + lettura sensori e poi spegne il Pi (halt).
# Utente e percorsi sono quelli del nostro Pi (rpi5-03): vanno adattati.
# Documentazione: ../../docs/setup-risveglio.md
#
# Provenienza: scritta da noi seguendo la documentazione di systemd:
# https://www.freedesktop.org/software/systemd/man/latest/systemd.unit.html
# (SuccessAction, FailureAction, ConditionPathExists)
# https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html
# (Type=oneshot, TimeoutStartSec, EnvironmentFile)
#
# Note sulle direttive:
# - SuccessAction/FailureAction=poweroff: il Pi si spegne SEMPRE alla fine,
#   sia se lo scatto riesce sia se fallisce o va in timeout. Nell'app
#   selettiva un Pi rimasto acceso per un errore consumerebbe energia
#   finché qualcuno non interviene.
# - TimeoutStartSec: se lo script si blocca (camera, GPS, ...) dopo questo
#   tempo systemd lo termina e l'unità risulta fallita, quindi il Pi si spegne.
#   Con Type=oneshot, se non lo si imposta, il timeout è disattivato.
# - ConditionPathExists=!...: "interruttore di manutenzione". Se esiste il
#   file /boot/firmware/maintenance l'unità viene saltata (non conta come
#   fallimento) e il Pi resta acceso, così ci si può collegare in SSH.
#   Il file si può creare anche dal PC, inserendo la microSD: la partizione
#   di boot è FAT32 e si legge da qualsiasi sistema operativo.
# - EnvironmentFile con "-" davanti: se il file non esiste non è un errore.

[Unit]
Description=Selective oneshot capture after ESP wake, then halt
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/boot/firmware/maintenance
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=oneshot
TimeoutStartSec=180
User=rpi5-03
WorkingDirectory=/home/rpi5-03/tesi
Environment=PROJECT_DIR=/home/rpi5-03/tesi
Environment=CAPTURE_MODE=selective
EnvironmentFile=-/home/rpi5-03/tesi/.env.systemd
ExecStart=/bin/bash /home/rpi5-03/tesi/raspberry_pi/capture_rpi.sh --oneshot
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
