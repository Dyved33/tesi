# Variabili d'ambiente per gli script di scatto e sensori sul Raspberry Pi.
# Copiare questo file nella root del progetto come .env.systemd e adattarlo.
# Lo leggono sia capture_rpi.sh sia l'unità systemd.
# Provenienza: file scritto da noi.
#
# ATTENZIONE: oggi gli script usano solo CAPTURE_INTERVAL e le variabili
# Python (PYENV_*). CAPTURE_MODE, DAILY_WINDOW_* e SENSOR_INTERVAL sono
# segnaposto per funzioni non ancora implementate (vedi issues.md).

# --- Modalità di funzionamento ---
# selective  = una foto dopo il wake, poi halt (insect-capture.service)
# continuous = il Pi resta acceso nella fascia oraria, nessuno spegnimento automatico
CAPTURE_MODE=selective

# --- Scatto (Camera Module 3, poi anche la seconda camera) ---
# Secondi tra una foto e l'altra in modalità continua. Esempio del piano: 300 (5 min).
CAPTURE_INTERVAL=30

# Fascia oraria per la modalità continua (ora locale, HH:MM) - non ancora usata
# DAILY_WINDOW_START=06:00
# DAILY_WINDOW_END=20:00

# --- Sensori sul Pi (metano, suolo, acqua, GPS). Il BME280 sta solo sull'ESP. ---
# Secondi tra due letture in modalità continua. Esempio del piano: 60 (1 min) - non ancora usata
SENSOR_INTERVAL=60

# --- Ambiente Python (sceglierne uno) ---
# PYENV_VERSION=3.11.9
# PYENV_ROOT=/home/rpi5-03/.pyenv
# Oppure un normale virtualenv (capture_rpi.sh lo attiva con bin/activate):
# PYENV_ROOT=/home/rpi5-03/venv

# Root del progetto, se diversa da quella ricavata dallo script
# PROJECT_DIR=/home/rpi5-03/tesi
