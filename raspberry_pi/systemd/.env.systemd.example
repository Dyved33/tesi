# Variabili d'ambiente per gli script del Raspberry Pi.
# Copiare questo file nella root del progetto come .env.systemd e adattarlo.
# Lo leggono sia capture_rpi.sh sia l'unità systemd.
# Provenienza: file scritto da noi.

# Root del progetto e virtualenv
PROJECT_DIR=/home/rpi5-03/progetto
VENV_DIR=/home/rpi5-03/progetto/raspberry_pi/.venv

# Cartella dei dati (foto, CSV). Di default raspberry_pi/data.
# SMARTCAM_DATA_DIR=/home/rpi5-03/dati

# Cadenze della modalità continuativa, in secondi (piano: misure ogni
# minuto, foto ogni cinque minuti).
CAPTURE_INTERVAL=300
SENSOR_INTERVAL=60

# Fascia oraria della modalità continuativa (ora locale, HH:MM).
# Commentate = tutto il giorno.
# DAILY_WINDOW_START=06:00
# DAILY_WINDOW_END=20:00

# Porte seriali (vedi docs/pinout.md)
ESP_PORT=/dev/ttyAMA0
GPS_PORT=/dev/ttyAMA2
